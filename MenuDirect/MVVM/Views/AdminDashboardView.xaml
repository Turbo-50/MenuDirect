<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MenuDirect.MVVM.Views.AdminDashboardView"
             BackgroundColor="#F2F4F7"
             Title="Administración">

    <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">
        <Label Text="Panel de Administración"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#0F172A"
               HorizontalOptions="Center"/>

        <Label Text="Gestión de personal y catálogo de productos"
               FontSize="14"
               TextColor="#475569"
               HorizontalOptions="Center"/>

        <Button Text="Administrar Empleados"
                Clicked="OnEmpleadosClicked"
                BackgroundColor="CornflowerBlue"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="14"
                HeightRequest="56"/>

        <Button Text="Administrar Productos"
                Clicked="OnProductosClicked"
                BackgroundColor="ForestGreen"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="14"
                HeightRequest="56"/>

        <Button Text="Cerrar sesión"
                Clicked="OnCerrarSesionClicked"
                BackgroundColor="#E2E8F0"
                TextColor="#0F172A"
                FontAttributes="Bold"
                FontSize="14"
                CornerRadius="12"
                HeightRequest="46"
                Margin="0,12,0,0"/>
    </VerticalStackLayout>
</ContentPage>
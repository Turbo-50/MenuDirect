<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MenuDirect.MVVM.Views.AdminEmpleadosView"
             xmlns:model="clr-namespace:MenuDirect.MVVM.Models"
             xmlns:vm="clr-namespace:MenuDirect.MVVM.ViewModel"
             x:DataType="vm:AdminEmpleadosViewModel"
             x:Name="PaginaEmpleados"
             BackgroundColor="#F2F4F7"
             Title="Empleados">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="10">
        <!-- Encabezado -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Button Text="&#xF177;"
                    FontFamily="Icons"
                    FontSize="20"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="20"
                    BackgroundColor="CornflowerBlue"
                    TextColor="White"
                    Command="{Binding VolverCommand}"/>

            <Label Grid.Column="1"
                   Text="Gestión de Empleados"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#0F172A"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Formulario nuevo empleado -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="12">
            <VerticalStackLayout Spacing="8">
                <Entry Placeholder="Nombre completo" Text="{Binding Nombre}"/>
                <Entry Placeholder="Nombre de usuario" Text="{Binding NombreUsuario}"/>
                <Entry Placeholder="Contraseña" Text="{Binding Contrasena}" IsPassword="True"/>
                <Picker Title="Rol"
                        ItemsSource="{Binding RolesDisponibles}"
                        SelectedItem="{Binding RolSeleccionado}"/>
                <Button Text="Agregar Empleado"
                        Command="{Binding CrearEmpleadoCommand}"
                        BackgroundColor="CornflowerBlue"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="42"/>
            </VerticalStackLayout>
        </Border>

        <!-- Listado de empleados activos -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Empleados}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Usuario">
                    <Border Margin="0,4"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Nombre}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"/>
                                <Label Text="{Binding NombreUsuario, StringFormat='Usuario: {0}'}"
                                       FontSize="12"
                                       TextColor="#475569"/>
                                <Label Text="{Binding Rol, StringFormat='Rol: {0}'}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="CornflowerBlue"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Eliminar"
                                    BackgroundColor="Crimson"
                                    TextColor="White"
                                    CornerRadius="10"
                                    Padding="12,6"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={x:Reference PaginaEmpleados}, Path=BindingContext.EliminarEmpleadoCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
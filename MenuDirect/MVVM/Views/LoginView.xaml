<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MenuDirect.MVVM.Views.LoginView"
             xmlns:vm="clr-namespace:MenuDirect.MVVM.ViewModel"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#F4F6F9"
             Title="Iniciar sesión">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18" VerticalOptions="Center">
            <Label Text="MenuDirect"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="CornflowerBlue"
                   HorizontalOptions="Center"/>

            <Label Text="Acceso al sistema"
                   FontSize="18"
                   TextColor="#444444"
                   HorizontalOptions="Center"/>

            <Border BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="18">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Usuario" FontAttributes="Bold" TextColor="#222222"/>
                        <Entry Placeholder="Ingrese su usuario"
                               Text="{Binding Usuario}"
                               Keyboard="Text"
                               ClearButtonVisibility="WhileEditing"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contraseña" FontAttributes="Bold" TextColor="#222222"/>
                        <Entry Placeholder="Ingrese su contraseña"
                               Text="{Binding Password}"
                               IsPassword="True"
                               ClearButtonVisibility="WhileEditing"/>
                    </VerticalStackLayout>

                    <Button Text="Iniciar sesión"
                            Command="{Binding IniciarSesionCommand}"
                            BackgroundColor="CornflowerBlue"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48"/>

                    <ActivityIndicator IsRunning="{Binding EstaCargando}"
                                       IsVisible="{Binding EstaCargando}"
                                       Color="CornflowerBlue"
                                       HorizontalOptions="Center"/>

                    <Label Text="{Binding Mensaje}"
                           IsVisible="{Binding MostrarMensaje}"
                           TextColor="Crimson"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>